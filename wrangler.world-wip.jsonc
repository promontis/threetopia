{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threetopia-world-wip",
  "account_id": "403d2b98d35ee85533629161a1b24a03",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  // Explicit fallback: deploy this config to replace the map preview with the WIP page.
  "routes": [{ "pattern": "world.threetopia.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist/world-wip",
    "not_found_handling": "none"
  }
}
