{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "vite.world-map.config.ts",
    "playwright.config.ts",
    "tests",
    "vite.tidewater.config.ts",
    "playwright.tidewater.config.ts",
    "playwright.full-scene.config.ts"
  ]
}
