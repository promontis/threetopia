{
  "name": "threetopia-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Threetopia creator landing page and four connected, walkable Three.js source worlds.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm db:migrate:local && vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply WAITLIST_DB --local",
    "waitlist:export": "node scripts/export-waitlist.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "build:world-wip": "node scripts/build-world-wip.mjs",
    "deploy:world-wip": "pnpm build:world-wip && wrangler deploy --config wrangler.world-wip.jsonc",
    "map:capture": "node scripts/atlas/capture.mjs",
    "map:capture:lagoon": "node scripts/atlas/capture-lagoon.mjs",
    "map:review:lagoon": "node scripts/atlas/render-lagoon-native.mjs",
    "map:live:lagoon": "node scripts/atlas/render-lagoon-native.mjs --live",
    "map:bake:lagoon": "node scripts/atlas/render-lagoon-native.mjs --bake && python3 scripts/atlas/pack-lagoon-bake.py",
    "atlas:bake": "node --experimental-strip-types scripts/atlas/bake.ts",
    "threetopia": "node packages/cli/bin/threetopia.js",
    "map:build:lagoon-lite": "node scripts/atlas/render-lagoon-native.mjs --extract-icon && node scripts/atlas/build-lagoon-lite.mjs",
    "map:build:lite": "node scripts/atlas/extract-map-landmarks.mjs tidewater sakura forest && node scripts/atlas/build-map-landmarks.mjs tidewater sakura forest && node scripts/atlas/build-map-environment.mjs && pnpm map:build:punk && pnpm map:build:wildlife",
    "map:build:punk": "node scripts/atlas/extract-map-landmarks.mjs punk-car && node --experimental-strip-types scripts/atlas/build-punk-city.mjs",
    "map:build:wildlife": "node scripts/atlas/build-tidewater-wildlife.mjs",
    "map:build:clouds": "node --experimental-strip-types scripts/atlas/build-map-clouds.ts",
    "build:world-map": "pnpm typecheck && vite build --config vite.world-map.config.ts && node scripts/build-world-map.mjs",
    "deploy:world-map": "pnpm build:world-map && wrangler deploy --config wrangler.world-map.jsonc",
    "build:cli": "node scripts/creators/build-cli.mjs && node scripts/creators/pack.mjs",
    "build:docs": "pnpm build:cli && node scripts/creators/build-docs.mjs",
    "deploy:docs": "pnpm build:docs && wrangler deploy --config wrangler.docs.jsonc",
    "build:creators": "pnpm build:world-map && vite build --config vite.creators.config.ts && node scripts/creators/build-site.mjs",
    "dev:creators": "wrangler d1 migrations apply DB --local --config wrangler.creators.jsonc && wrangler dev --config wrangler.creators.jsonc --port 55020 --host 127.0.0.1:55020 --var AUTH_LOCAL:true",
    "deploy:creators": "pnpm build:creators && wrangler d1 migrations apply DB --remote --config wrangler.creators.jsonc && wrangler deploy --config wrangler.creators.jsonc",
    "example:tidewater": "node examples/tidewater/build.mjs",
    "dev:example:tidewater": "vite --config vite.tidewater.config.ts",
    "build:example:tidewater": "vite build --config vite.tidewater.config.ts",
    "test:cli:integration": "node scripts/creators/run-integration.mjs",
    "test:conversion": "playwright test --config playwright.tidewater.config.ts",
    "check:quality": "pnpm build:cli && pnpm typecheck && pnpm test && pnpm test:cli:integration && pnpm test:cli:release && pnpm test:conversion",
    "test:cli:release": "node scripts/creators/release-test.mjs",
    "example:tidewater:full": "node examples/tidewater/build-full.mjs",
    "dev:example:tidewater:full": "node scripts/creators/serve-full-scene.mjs",
    "test:scene:full": "playwright test --config playwright.full-scene.config.ts",
    "extract:tidewater": "node scripts/creators/extract-tidewater-packages.mjs",
    "example:tidewater:packages": "node examples/tidewater/build-packages.mjs"
  },
  "dependencies": {
    "@threetopia/source-lagoon": "workspace:*",
    "@threetopia/source-punk": "workspace:*",
    "@threetopia/source-sakura": "workspace:*",
    "@threetopia/source-tidewater": "workspace:*",
    "@threetopia/world-map": "workspace:*",
    "html-to-image": "1.11.13",
    "mediabunny": "1.59.0",
    "three": "0.184.0",
    "three-fenestra": "0.3.0",
    "three-mesh-bvh": "0.9.13",
    "three-world": "npm:three@0.186.0",
    "@dgreenheck/tidewater-rocks": "workspace:*",
    "@dgreenheck/tidewater-gulls": "workspace:*",
    "@dgreenheck/tidewater-map-tile": "workspace:*",
    "@dgreenheck/tidewater-vegetation": "workspace:*"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@cloudflare/puppeteer": "1.4.0",
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/workers-types": "5.20260927.1",
    "@playwright/test": "1.63.0",
    "@threetopia/cli": "workspace:*",
    "@types/node": "^24.13.6",
    "@types/three": "0.184.1",
    "@webgpu/types": "0.1.60",
    "esbuild": "0.28.2",
    "marked": "18.0.14",
    "meshoptimizer": "1.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.141.0"
  }
}
