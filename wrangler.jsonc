{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threetopia",
  "account_id": "403d2b98d35ee85533629161a1b24a03",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  // world.threetopia.com belongs to the separate wrangler.world-map.jsonc deployment.
  // Do not attach it to the playable world in a landing-page deployment.
  "routes": [
    { "pattern": "threetopia.com", "custom_domain": true },
    { "pattern": "www.threetopia.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/world", "/world/", "/world/index.html", "/api/*", "/waitlist/*", "/docs", "/docs/*"]
  },
  "vars": {
    "WAITLIST_LOCAL": "false",
    "SITE_URL": "https://threetopia.com",
    "WORLD_URL": "https://world.threetopia.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFE-VAGHzfLUc4-w",
    "WAITLIST_FROM": "hello@threetopia.com"
  },
  "d1_databases": [{
    "binding": "WAITLIST_DB",
    "database_name": "threetopia-waitlist",
    "database_id": "e012590a-2c2a-4ab7-9dc1-37475a62b716",
    "migrations_dir": "migrations"
  }],
  "send_email": [{
    "name": "WAITLIST_EMAIL",
    "allowed_sender_addresses": ["hello@threetopia.com"]
  }],
  "ratelimits": [{
    "name": "WAITLIST_LIMITER",
    "namespace_id": "51901001",
    "simple": { "limit": 10, "period": 60 }
  }]
}
